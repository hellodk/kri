# Copy to .env.docker and fill in real values before running the stack.
# .env.docker is gitignored — never commit it.

# ── Database ──────────────────────────────────────────────────────────────────
# POSTGRES_PASSWORD and REDIS_PASSWORD MUST be set explicitly — docker-compose
# will refuse to start if these are missing (no insecure defaults are provided).
POSTGRES_PASSWORD=CHANGE_ME_db_password
REDIS_PASSWORD=CHANGE_ME_redis_password
DATABASE_URL=postgresql+psycopg://fleet:CHANGE_ME_db_password@db:5432/fleet_platform
TEST_DATABASE_URL=postgresql+psycopg://fleet:CHANGE_ME_db_password@db:5432/fleet_test

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_with__python3_-c__import_secrets__print(secrets.token_hex(32))
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost
ENVIRONMENT=production

# ── Platform settings defaults (non-secret) ───────────────────────────────────
# These seed the platform_settings table on first start (or after a DB wipe).
# Non-secret values only — passwords/tokens go through the Settings UI.
#
# KRI_API_URL       External URL of this kri server (how Mac Minis call back)
# SALT_MASTER_ADDRESS  IP/hostname of Salt master (usually same as KRI_API_URL host)
# PILLAR_DIR        Where Salt pillar files are written (default: /srv/salt/pillar)
# PLAYBOOKS_DIR     Override playbooks directory (default: <repo>/playbooks)
# SSH_BOOTSTRAP_USERNAME  Default SSH user for bootstrap (per-node creds take priority)
# LLM_EMBED_BASE_URL  RAG embedding server (OpenAI-compatible). Seeded here so the
#                     RAG config is RETAINED across redeploys / DB wipes instead of
#                     reverting to empty. A value set via the Settings UI always wins.
# LLM_INCLUDE_NODE_IPS  "true"/"false" — include node IPs in the LLM fleet context.
KRI_API_URL=http://YOUR_SERVER_IP
SALT_MASTER_ADDRESS=YOUR_SERVER_IP
PILLAR_DIR=/srv/salt/pillar
# LLM_EMBED_BASE_URL=http://YOUR_EMBED_HOST:8080
# LLM_INCLUDE_NODE_IPS=true
# ── Salt HTTP API (required after Docker socket removal, issue #82) ──────────
# The worker dispatches Salt commands via the salt-api HTTP interface.
# Add the rest_cherrypy module to salt-master.conf to enable it.
# See: https://docs.saltproject.io/en/latest/ref/netapi/all/salt.netapi.rest_cherrypy.html
SALT_API_URL=http://salt-master:8080
SALT_API_USER=CHANGE_ME_salt_api_user
SALT_API_PASSWORD=CHANGE_ME_salt_api_password
# SALT_API_EAUTH=pam
# ── Salt master port publication (optional — change only if defaults conflict) ─
# SALT_MASTER_PUBLISH_PORT=4505
# SALT_MASTER_RETURN_PORT=4506
# SALT_API_PORT=8080
# PLAYBOOKS_DIR=/path/to/custom/playbooks
# SSH_BOOTSTRAP_USERNAME=localadmin

# ── Volume path overrides ─────────────────────────────────────────────────────
# PULSE_REPOS_DIR    Host path to the Pulse playbook repository.
#                    Default: ./pulse  (deploy/pulse/ relative to the compose file)
#                    Set this to wherever your pulse checkout lives on the host.
# PULSE_REPOS_DIR=/path/to/pulse

# PLAYBOOKS_FILES_DIR  Host path to playbooks/files (large gitignored binaries for
#                      air-gapped installs, e.g. salt .pkg files).
#                      Default: ../playbooks/files  (kri repo root playbooks/files/)
# PLAYBOOKS_FILES_DIR=/path/to/kri/playbooks/files

# KRI_DATA_DIR       Host path for the kri data directory (id_rsa keypair etc.).
#                    Default: ~/.kri  (current user's home directory)
# KRI_DATA_DIR=/home/myuser/.kri

# ── Playbook path translation (host path → container path) ────────────────────
# When playbook source paths are configured via the Settings UI using host-side
# absolute paths, this map tells kri how to translate them inside Docker where
# host volumes are mounted at different prefixes.
# Format: host_prefix:container_prefix  (comma-separated for multiple entries)
# Example: if PULSE_REPOS_DIR=/srv/pulse, the map is:
# PLAYBOOK_PATH_MAP=/srv/pulse:/mnt/pulse

# ── Worker SSH key directory ──────────────────────────────────────────────────
# Path to a directory containing a DEDICATED service-account keypair used by
# Ansible playbook execution in the worker container.
# DO NOT point this at your personal ~/.ssh — use a dedicated keypair.
# Setup:
#   mkdir -p deploy/ssh
#   ssh-keygen -t ed25519 -f deploy/ssh/id_ed25519 -N ""
#   # distribute deploy/ssh/id_ed25519.pub to target Mac Minis
# deploy/ssh/ is gitignored (except .gitkeep) — never commit private keys.
WORKER_SSH_DIR=./ssh

# ── nginx resolver (Docker / Podman / k8s) ────────────────────────────────────
# DNS server used by nginx to re-resolve the 'api' upstream on every request.
# Default 127.0.0.11 is Docker's embedded DNS — works for docker-compose users.
# Override for Podman rootful (10.88.0.1) or rootless (10.0.2.3); see
# deploy/nginx.conf.template for the full matrix.
# NGINX_RESOLVER=127.0.0.11

# ── Database backup encryption + offsite sync ────────────────────────────────
# Optional. If both unset, pg_backup writes plain dumps to a local Docker
# volume only — single-disk-failure away from total loss.
#
# BACKUP_AGE_RECIPIENT: an age public key (https://age-encryption.org) that
#   each daily dump is encrypted to before leaving the container. Generate:
#     age-keygen -o ~/keys/kri-backup.key       # private key — keep offline
#     age-keygen -y ~/keys/kri-backup.key       # public key — paste here
# BACKUP_AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# BACKUP_REMOTE: an rclone remote target (e.g. b2:my-bucket/kri/, s3:..., or
#   sftp:host:/path/). Configure the remote via BACKUP_RCLONE_CONFIG below.
# BACKUP_REMOTE=
#
# BACKUP_RCLONE_CONFIG: contents of rclone.conf (multi-line). Use docker
# compose's literal-newline syntax (\n) or a stack secret in production.
# BACKUP_RCLONE_CONFIG=
