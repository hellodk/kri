# salt/pillar/ml/mlx_cluster.sls.example
# Example MLX cluster configuration.
# Copy and customize this file to salt/pillar/ml/mlx_cluster.sls or include in top.sls

ml:
  mlx_cluster:
    role: coordinator        # or 'worker'
    coordinator_host: 10.0.1.100  # required for worker nodes, IP of coordinator
    port: 5555              # optional: cluster port, default 5555

# Artifactory PyPI proxy configuration (required)
artifactory:
  url: https://artifactory.internal
  pypi_proxy: https://artifactory.internal/artifactory/api/pypi/pypi-proxy/simple
  pip_trusted_host: artifactory.internal
