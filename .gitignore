*.crt
*.cer

# ── kri runtime ───────────────────────────────────────────────────────────────
.kri/
.kri-logs/
.kri-pids/
.worktrees/

# ── Screenshots & temp artifacts ─────────────────────────────────────────────
*.png
*.jpg
*.jpeg
!frontend/src/assets/**

# ── IDE & OS ──────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Worker SSH keys (issue #91) ───────────────────────────────────────────────
# deploy/ssh/ holds a DEDICATED service-account keypair for the worker container.
# Never commit private keys. The .gitkeep is kept to preserve the directory.
deploy/ssh/*
!deploy/ssh/.gitkeep

# ── TLS certificates (issue #131) ──────────────────────────────────────────────
# deploy/certs/ holds self-signed or CA certificates for nginx-tls.conf.
# Never commit private keys. Generate with scripts/gen_self_signed_cert.sh
deploy/certs/

# Salt-master PKI — private key is NEVER committed
# master.pem is stored in ansible vault, backed up via `kri pki-backup`
deploy/salt-pki/master.pem

# Bundled installer packages (too large for git — store on kri server)
playbooks/files/*.pkg
playbooks/files/*.pkg.sha512
