.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
coverage.xml
pytestdebug.log
celerybeat-schedule
celerybeat.pid

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/

# ── Playwright ────────────────────────────────────────────────────────────────
test-results/
playwright-report/
.playwright-mcp/

