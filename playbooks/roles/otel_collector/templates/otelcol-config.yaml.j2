receivers:
  prometheus:
    config:
      scrape_configs:
        - job_name: node
          scrape_interval: 30s
          static_configs:
            - targets: ["127.0.0.1:9100"]
exporters:
  {% if otlp_protocol == 'grpc' %}otlp{% else %}otlphttp{% endif %}:
    endpoint: "{{ otlp_endpoint }}"
{% if otlp_headers %}
    headers:
      {{ otlp_headers }}
{% endif %}
service:
  pipelines:
    metrics:
      receivers: [prometheus]
      exporters: [{% if otlp_protocol == 'grpc' %}otlp{% else %}otlphttp{% endif %}]
