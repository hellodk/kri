# kri Salt Master configuration — managed by Ansible role salt_master
# Installed to /etc/salt/master.d/kri.conf on {{ inventory_hostname }}

# Keys must be manually accepted via kri UI (Settings → Minion Keys)
auto_accept: False

# Pillar data per minion (ingest_url + node_token written by kri worker)
pillar_roots:
  base:
    - {{ salt_pillar_dir }}

# kri Salt states (grain_report, heartbeat, sbom_scan, etc.)
file_roots:
  base:
    - {{ salt_states_dir }}

# Listen on all interfaces so LAN-connected minions can reach this host
interface: {{ salt_master_interface }}

# Log to file (not stdout — native service, not Docker container)
log_file: {{ salt_log_dir }}/master
log_level: info

# Presence detection — marks minions as connected/disconnected
presence_events: {{ salt_presence_events | lower }}
loop_interval: {{ salt_loop_interval }}

# Reactor: fire grain_report immediately when any minion starts/reconnects.
# This ensures kri marks nodes online within seconds of reconnect.
reactor:
  - 'salt/minion/*/start':
    - salt://reactor/grain_report_on_start.sls

# Salt 3006+ disables all netapi clients by default (salt-api returns
# "400 Client disabled" otherwise). Enable exactly the clients kri uses:
#   local / local_async — fleet exec commands on minions
#   runner             — manage.* fleet status
#   wheel              — key.* minion-key management
# The external_auth ACL below still scopes which functions each may call.
netapi_enable_clients:
  - local
  - local_async
  - runner
  - wheel

# External auth for salt-api (kri workers authenticate as {{ salt_api_user }}).
# Scoped to only what kri needs: local-client execution functions, minion keys,
# and fleet status runners. No wildcard ('.*') or bare runner/wheel access.
#
# IMPORTANT: The local-client function list below MUST stay in parity with
# _DEFAULT_SALT_FUNCTIONS in fleet_platform/services/platform_settings_svc.py.
# That constant is the single source of truth for the app-side allowlist.
# Any function added there must also be added here, or salt-api will deny it.
external_auth:
  pam:
    {{ salt_api_user }}:
      # Local-client execution functions — mirrors _DEFAULT_SALT_FUNCTIONS
      - 'state.apply'
      - 'state.highstate'
      - 'state.show_sls'
      - 'pkg.install'
      - 'pkg.remove'
      - 'pkg.list_pkgs'
      - 'pkg.upgrade'
      - 'pip.install'
      - 'pip.installed'
      - 'pip.list'
      - 'service.start'
      - 'service.stop'
      - 'service.restart'
      - 'service.disable'
      - 'service.enable'
      - 'service.status'
      - 'service.get_all'
      - 'service.available'
      - 'service.enabled'
      - 'disk.usage'
      - 'disk.inodeusage'
      - 'status.loadavg'
      - 'status.meminfo'
      - 'grains.items'
      - 'grains.get'
      - 'test.ping'
      - 'test.version'
      - 'saltutil.sync_all'
      - 'saltutil.refresh_grains'
      - 'saltutil.refresh_pillar'
      - 'system.reboot'
      # cmd.run removed: grants arbitrary shell RCE on any minion (#758)
      - 'ps.list_processes'
      - 'ps.kill_pid'
      # Wheel client — minion key management
      - '@wheel':
        - 'key.list_all'
        - 'key.accept'
        - 'key.reject'
        - 'key.delete'
      # Runner client — fleet status queries
      - '@runner':
        - 'manage.up'
        - 'manage.versions'
        - 'manage.status'
