# salt-api configuration — managed by Ansible role salt_master
# Provides the HTTP API used by kri API/worker containers to run salt commands.
# Installed to /etc/salt/master.d/salt-api.conf on {{ inventory_hostname }}
#
# TLS is terminated by salt-api itself using a self-signed cert generated by
# the api_tls.yml task. Masters run on LAN, so the API
# must be encrypted at the service boundary. kri connects via https://<addr>:<port>.

rest_cherrypy:
  port: {{ salt_api_port }}
  disable_ssl: false
  ssl_crt: {{ salt_api_ssl_crt }}
  ssl_key: {{ salt_api_ssl_key }}
  webhook_disable_auth: false
