FROM python:3.13.3-slim AS builder
WORKDIR /app

# Build deps: gcc for compiling psycopg C extensions, libpq-dev for headers
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install uv
COPY pyproject.toml uv.lock VERSION ./
RUN uv sync --frozen --no-dev

FROM python:3.13.3-slim AS runtime
WORKDIR /app

# Runtime deps:
#   libpq5       — psycopg PostgreSQL driver
#   git          — ansible-runner git source support
#   openssh-client — SSH connectivity for Ansible playbooks
#   sshpass      — required for Ansible password-based SSH auth (no TTY in container)
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    libpq5 git openssh-client sshpass \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/pyproject.toml /app/pyproject.toml
# uv binary needed by migrate.sh — builder installed it via pip, copy to runtime
COPY --from=builder /usr/local/bin/uv /usr/local/bin/uv
COPY fleet_platform/ ./fleet_platform/
COPY playbooks/ ./playbooks/
# salt/ holds the state tree the salt_master role syncs to the master host
# (playbook references {{ playbook_dir }}/../salt/states/ = /app/salt/states).
COPY salt/ ./salt/
COPY alembic.ini ./
COPY deploy/migrate.sh /app/deploy/migrate.sh

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV PATH="/app/.venv/bin:$PATH"

# Create a non-root user to run the application (issue #88).
# Docker volume mounts (salt-pillar, etc.) use UID/GID at runtime; if pillar
# writes fail, operators must run: chown -R 1001:1001 <volume-path>
RUN groupadd --gid 1001 appgroup && \
    useradd --uid 1001 --gid appgroup --shell /bin/bash --create-home appuser && \
    chown -R appuser:appgroup /app
# Agent quarantine root (AGENT_QUARANTINE_ROOT, default /srv/kri/agent-quarantine).
# /srv is root-owned, so the non-root appuser cannot create it at runtime —
# pre-create it owned by appuser, otherwise every agent artifact write
# (generate_ansible_playbook / generate_salt_state / dry_run_artifact) fails
# with PermissionError and the authoring/quarantine feature is unusable.
RUN mkdir -p /srv/kri/agent-quarantine && chown -R appuser:appgroup /srv/kri
USER appuser
