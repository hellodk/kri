# TEMPLATE — do NOT commit with real values.
# Seal this file with kubeseal before committing:
#
#   kubectl create secret generic kri-secrets \
#     --from-literal=POSTGRES_PASSWORD=<password> \
#     --from-literal=REDIS_PASSWORD=<password> \
#     --from-literal=JWT_SECRET=<min-32-char-secret> \
#     --from-literal=FERNET_SECRET_KEY=<base64-fernet-key> \
#     --from-literal=SALT_API_URL=<http://mm1:8080> \
#     --from-literal=SALT_API_USER=<user> \
#     --from-literal=SALT_API_PASSWORD=<password> \
#     --dry-run=client -o yaml | \
#   kubeseal --format yaml > deploy/k8s/sealed-secret.yaml
#
# Commit only sealed-secret.yaml — never plain secret.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: kri-secrets
  namespace: kri
type: Opaque
stringData:
  POSTGRES_PASSWORD: "REPLACE_ME"
  REDIS_PASSWORD: "REPLACE_ME"
  JWT_SECRET: "REPLACE_ME_min_32_chars"
  FERNET_SECRET_KEY: "REPLACE_ME_base64_fernet_key"
  SALT_API_URL: "http://mm1.local:8080"
  SALT_API_USER: "REPLACE_ME"
  SALT_API_PASSWORD: "REPLACE_ME"
---
# Worker SSH keypair — mounted into kri-worker and kri-worker-ansible at
# /home/appuser/.ssh. Without this, every Ansible bootstrap and playbook run
# fails with "Permission denied (publickey)".
#
# Generate a dedicated service-account keypair (do NOT reuse an operator's
# personal key — see #91):
#
#   ssh-keygen -t ed25519 -f /tmp/kri-worker -N "" -C "kri-worker"
#   ssh-keyscan -t ed25519 mm1.local >> /tmp/kri-worker_known_hosts
#
#   kubectl -n kri create secret generic kri-worker-ssh \
#     --from-file=id_ed25519=/tmp/kri-worker \
#     --from-file=id_ed25519.pub=/tmp/kri-worker.pub \
#     --from-file=known_hosts=/tmp/kri-worker_known_hosts \
#     --dry-run=client -o yaml | \
#   kubeseal --format yaml > deploy/k8s/sealed-secret-worker-ssh.yaml
#
# Distribute id_ed25519.pub to every fleet node's ~/.ssh/authorized_keys.
apiVersion: v1
kind: Secret
metadata:
  name: kri-worker-ssh
  namespace: kri
type: Opaque
stringData:
  id_ed25519: |
    REPLACE_ME_with_ssh_private_key
  id_ed25519.pub: "REPLACE_ME_with_ssh_public_key"
  known_hosts: "REPLACE_ME_with_ssh_keyscan_output"
