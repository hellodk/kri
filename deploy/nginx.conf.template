# Re-resolve upstream DNS on every request cycle so the nginx container
# tolerates an api-pod IP change without a frontend restart.
#
# NGINX_RESOLVER is substituted at container start via the nginx image's
# /etc/nginx/templates entrypoint (see deploy/Dockerfile.frontend). Defaults:
#   Docker (default bridge / docker-compose): 127.0.0.11
#   Podman rootful (netavark default):        10.88.0.1
#   Podman rootless (slirp4netns / pasta):    10.0.2.3
#   Kubernetes (resolve via cluster DNS):     kube-dns.kube-system.svc.cluster.local
#                                             (or just remove the resolver line and
#                                              rely on Service VIPs which are stable)
resolver ${NGINX_RESOLVER} valid=5s ipv6=off;

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers — apply to all responses including 4xx/5xx (always)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # WebSocket endpoints — SSH and VNC proxies hold in-process session state.
    # Use a variable for proxy_pass so nginx re-resolves DNS on reconnect.
    location ~ ^/api/v1/(ssh|vnc)/session/ {
        set $api_upstream http://api:8000;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 10s;
    }

    # All other API/auth requests
    location ~ ^/(auth|api)/ {
        set $api_upstream http://api:8000;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Expect "";
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
    }

    # Prometheus metrics — proxied to the API and restricted to private/Tailscale
    # source networks so a scraper (compose, on-host k0s, or standalone) can reach
    # /metrics while it is never world-readable. The API itself serves no secrets
    # here, but minion IDs/counts shouldn't leak publicly (#356/#419).
    location = /metrics {
        allow 127.0.0.0/8;       # loopback
        allow 10.0.0.0/8;        # RFC1918
        allow 172.16.0.0/12;     # RFC1918
        allow 192.168.0.0/16;    # RFC1918 / LAN
        allow 100.64.0.0/10;     # Tailscale CGNAT range
        deny all;
        set $api_upstream http://api:8000;
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }

    # K8s liveness/readiness probe — must not depend on upstream API.
    # Returns 200 OK as long as nginx itself is serving requests.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
