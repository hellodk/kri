# /etc/kri/kri.env — kri Fleet Platform environment configuration (standalone/systemd)
# Copy to /etc/kri/kri.env and fill in real values before starting services.
# Permissions: chmod 600 /etc/kri/kri.env  (readable by kri user only)
# NEVER commit this file with real secrets.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL must be running locally or reachable via the network.
# For standalone deployments, use 127.0.0.1 (not a container hostname).
DATABASE_URL=postgresql+psycopg://fleet:CHANGE_ME_db_password@127.0.0.1:5432/fleet_platform
TEST_DATABASE_URL=postgresql+psycopg://fleet:CHANGE_ME_db_password@127.0.0.1:5432/fleet_test

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis must be running locally or reachable via the network.
# For standalone deployments, use 127.0.0.1 (not a container hostname).
REDIS_URL=redis://:CHANGE_ME_redis_password@127.0.0.1:6379/0

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong random secret:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_with__python3_-c__import_secrets__print(secrets.token_hex(32))
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://YOUR_SERVER_IP
ENVIRONMENT=production

# ── Platform settings defaults (non-secret) ───────────────────────────────────
# KRI_API_URL       External URL of this kri server (how Mac Minis call back)
# SALT_MASTER_ADDRESS  IP/hostname of Salt master
# PILLAR_DIR        Where Salt pillar files are written (default: /srv/salt/pillar)
KRI_API_URL=http://YOUR_SERVER_IP
SALT_MASTER_ADDRESS=YOUR_SERVER_IP
PILLAR_DIR=/srv/salt/pillar

# ── Salt HTTP API ─────────────────────────────────────────────────────────────
# The Celery worker dispatches Salt commands via the salt-api HTTP interface.
# See: https://docs.saltproject.io/en/latest/ref/netapi/all/salt.netapi.rest_cherrypy.html
SALT_API_URL=http://YOUR_SALT_MASTER_IP:8080
SALT_API_USER=CHANGE_ME_salt_api_user
SALT_API_PASSWORD=CHANGE_ME_salt_api_password
# SALT_API_EAUTH=pam

# ── Worker SSH key directory ──────────────────────────────────────────────────
# Path to a directory containing a DEDICATED service-account keypair used by
# Ansible playbook execution. DO NOT use personal ~/.ssh keys.
#   ssh-keygen -t ed25519 -f /opt/kri/deploy/ssh/id_ed25519 -N ""
WORKER_SSH_DIR=/opt/kri/deploy/ssh

# ── Playbooks ────────────────────────────────────────────────────────────────
# PLAYBOOKS_DIR=/opt/kri/playbooks
# SSH_BOOTSTRAP_USERNAME=localadmin
