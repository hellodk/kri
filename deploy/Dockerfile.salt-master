FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gnupg \
    dumb-init \
    && rm -rf /var/lib/apt/lists/*

# Install salt-master 3007.x from the Salt Project's official repo
RUN curl -fsSL https://packages.broadcom.com/artifactory/api/security/keypair/SaltProjectKey/public \
      | gpg --dearmor -o /usr/share/keyrings/salt-archive-keyring.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/salt-archive-keyring.gpg arch=amd64] \
      https://packages.broadcom.com/artifactory/saltproject-deb/ stable main" \
      > /etc/apt/sources.list.d/salt.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends salt-master && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /etc/salt/master.d /srv/salt/pillar /srv/salt/states \
             /etc/salt/pki/master /var/log/salt /var/cache/salt

EXPOSE 4505 4506

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["/usr/bin/salt-master", "--log-level=info", "--log-file=/dev/stdout"]
