# ── Database ──────────────────────────────────────────────────────────────────
# Replace CHANGE_ME_db_password with a strong password.
# Must match POSTGRES_PASSWORD in your docker-compose environment / secrets.
DATABASE_URL=postgresql+psycopg://fleet:CHANGE_ME_db_password@db:5432/fleet_demo
TEST_DATABASE_URL=postgresql+psycopg://fleet:CHANGE_ME_db_password@db:5432/fleet_test

# ── Redis ─────────────────────────────────────────────────────────────────────
# Must match the --requirepass value passed to the redis service.
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_with__python3_-c__import_secrets__print(secrets.token_hex(32))
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS / Origins ────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost

# ── Runtime environment ───────────────────────────────────────────────────────
ENVIRONMENT=production

# ── Platform settings defaults (non-secret) ───────────────────────────────────
# These seed the platform_settings table on first start (or after a DB wipe).
# Edit here to change defaults; UI overrides persist in DB and take priority.
KRI_API_URL=http://YOUR_HOST_IP
SALT_MASTER_ADDRESS=YOUR_HOST_IP
PILLAR_DIR=/srv/salt/pillar
# RAG embedding server — seeded so it is RETAINED across redeploys / DB wipes
# (a value set via the Settings UI always wins).
# LLM_EMBED_BASE_URL=http://YOUR_EMBED_HOST:8080
# LLM_INCLUDE_NODE_IPS=true

# ── Playbook path translation (host path → container path) ────────────────────
# Format: host_prefix:container_prefix  (comma-separated for multiple mappings)
# The api and worker containers mount the host playbook repo at /mnt/pulse.
PLAYBOOK_PATH_MAP=/home/YOURUSER/Documents/git/pulse:/mnt/pulse

# ── Salt master container name ────────────────────────────────────────────────
SALT_MASTER_CONTAINER=deploy-salt-master-1

# ── Worker SSH key directory ──────────────────────────────────────────────────
# Path to a directory containing a DEDICATED service-account keypair for
# Ansible playbook execution. DO NOT point this at your personal ~/.ssh.
# Create a keypair:  ssh-keygen -t ed25519 -f deploy/ssh/id_ed25519 -N ""
# Then distribute the public key to target hosts.
# Default: ./ssh  (relative to docker-compose.yml location)
WORKER_SSH_DIR=./ssh

# ── Frontend nginx resolver ───────────────────────────────────────────────────
# Substituted into nginx.conf at container start so the frontend works on
# Docker (default), Podman, and k8s without rebuilding the image:
#   Docker / docker-compose:  127.0.0.11   (default — leave unset)
#   Podman rootful (netavark): 10.88.0.1
#   Podman rootless (slirp4netns): 10.0.2.3
#   Kubernetes:                 (let DNS handle it; service VIPs are stable)
# NGINX_RESOLVER=127.0.0.11

# ── pg_backup encryption + offsite sync ───────────────────────────────────────
# The pg_backup service can encrypt every dump with age and rclone-copy it to
# an offsite target. Both are optional — leave unset to keep dumps local and
# unencrypted (pre-existing behaviour). Strongly recommended for production.
#
# 1. Generate a recipient keypair on a separate machine (NEVER on the kri host):
#      age-keygen -o ~/keys/kri-backup.key
#      grep 'public key' ~/keys/kri-backup.key   # copy into BACKUP_AGE_RECIPIENT
# 2. Decrypt with:
#      age -d -i ~/keys/kri-backup.key < dump.age > dump
# BACKUP_AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# rclone destination — see https://rclone.org/docs/#syntax-of-remote-paths
# Examples:
#   b2:my-bucket/kri/                  Backblaze B2
#   s3:my-bucket/kri/                  AWS S3 / MinIO
#   sftp-host:/srv/backups/kri/        SFTP
# BACKUP_REMOTE=b2:kri-backups/

# Contents of an rclone.conf file. Multiline; use a heredoc when sourcing
# this file or set via your secret manager. The pg_backup service writes it
# to /root/.config/rclone/rclone.conf at startup.
# BACKUP_RCLONE_CONFIG=
